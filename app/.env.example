# 앱 환경변수 예시. 이 파일을 복사해 app/.env 를 만들고 값을 채우세요.
# 주의: EXPO_PUBLIC_ 로 시작하는 값은 앱 파일 안에 그대로 들어갑니다.
#       공개돼도 되는 값만 넣으세요. (service_role 키, DB 비밀번호, LLM 키 금지)

# Supabase (대시보드 > Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Spring API 서버 주소 (로컬 테스트 시 PC의 내부 IP, 예: http://192.168.0.10:8080)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# 네이버 지도 (네이버 클라우드 콘솔 > Maps > Application)
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=
