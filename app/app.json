{
  "expo": {
    "name": "서울메이트",
    "slug": "seoulmate",
    "scheme": "seoulmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 위치를 지도에 표시하기 위해 위치를 사용합니다.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://repository.map.naver.com/archive/maven"
            ]
          }
        }
      ]
    ],
    "ios": { "bundleIdentifier": "com.seoulmate.app" },
    "android": { "package": "com.seoulmate.app" },
    "web": { "bundler": "metro" }
  }
}
