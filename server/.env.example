# 서버 환경변수 예시. 이 파일을 복사해 server/.env 를 만들거나, 배포 환경의 환경변수로 등록하세요.
# 이 값들은 비밀입니다. 커밋하지 말고 DM으로만 공유하세요.

# Supabase Postgres - 대시보드 Connect > "Session pooler" 주소 사용 (direct 주소는 IPv6라 연결이 안 될 수 있음)
DB_URL=jdbc:postgresql://aws-<index>-<region>.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=

# Supabase 토큰 검증
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# AI 번역 (LLM API)
LLM_API_KEY=

# 장소 검색 API (스팟 등록용)
PLACE_SEARCH_API_KEY=

# 시연 모드: true면 방문 인증 위치 확인 건너뛰기, /dev API 열림. 운영에서는 반드시 false
DEMO_MODE=false
